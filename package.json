{
  "name": "siargao-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:up": "zsh -lc 'docker compose up -d db && export DATABASE_URL=${DATABASE_URL:-postgres://user:password@localhost:5432/siargao_portal} && bun run db:migrate && bun run db:seed && exec bun run dev'",
    "dev:container": "bun run src/server/container/start-dev-app.ts --serve-only",
    "dev:kill": "zsh -lc 'for port in 3000 3100; do for pid in $(lsof -ti tcp:$port 2>/dev/null); do kill $pid 2>/dev/null || true; sleep 0.2; kill -9 $pid 2>/dev/null || true; done; done'",
    "stack:up": "bun run src/server/container/stack.ts up-db",
    "stack:app:up": "bun run src/server/container/stack.ts up-app",
    "stack:down": "bun run src/server/container/stack.ts down",
    "stack:down:volumes": "bun run src/server/container/stack.ts down-volumes",
    "stack:logs": "bun run src/server/container/stack.ts logs",
    "stack:ps": "bun run src/server/container/stack.ts ps",
    "build": "zsh -lc 'rm -rf .next && NEXT_PRIVATE_BUILD_WORKER=0 ./node_modules/.bin/next build'",
    "db:migrate": "bun run src/server/db/migrate.ts",
    "db:seed": "bun run src/server/db/seed.ts",
    "db:discover:google-places": "bun run src/server/providers/discover-google-places.ts",
    "db:enrich:google-places": "bun run src/server/providers/enrich-google-places.ts",
    "db:prune:google-places": "bun run src/server/jobs/prune-google-places.ts",
    "db:ingest:open-meteo": "bun run src/server/providers/ingest-open-meteo.ts",
    "agent-memory:sync": "bun run src/server/chat/sync-agent-memory-vector-store.ts",
    "db:migrate:test": "bun run src/server/db/migrate-test.ts",
    "db:seed:test": "bun run src/server/db/seed-test.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format && bun run lint && bun run typecheck && bun run test",
    "test": "bun test",
    "test:e2e": "playwright test",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "openai": "^6.44.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
