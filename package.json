{
  "name": "siargao-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "next dev",
    "dev:up": "docker compose up -d --wait --wait-timeout 60 db && export DATABASE_URL=${DATABASE_URL:-postgres://user:password@localhost:5432/siargao_portal} && bun run db:migrate && bun run db:seed && exec bun run dev",
    "dev:container": "bun run src/server/container/start-dev-app.ts --serve-only",
    "dev:kill": "for port in 3000 3100; do for pid in $(lsof -ti tcp:$port 2>/dev/null); do kill $pid 2>/dev/null || true; sleep 0.2; kill -9 $pid 2>/dev/null || true; done; done",
    "stack:up": "bun run src/server/container/stack.ts up-db",
    "stack:app:up": "bun run src/server/container/stack.ts up-app",
    "stack:down": "bun run src/server/container/stack.ts down",
    "stack:down:volumes": "bun run src/server/container/stack.ts down-volumes",
    "stack:logs": "bun run src/server/container/stack.ts logs",
    "stack:ps": "bun run src/server/container/stack.ts ps",
    "build": "bun run validate:clerk-deployment && rm -rf .next && NEXT_PRIVATE_BUILD_WORKER=0 ./node_modules/.bin/next build",
    "db:migrate": "bun run src/server/db/migrate.ts",
    "db:seed": "bun run src/server/db/seed.ts",
    "db:discover:google-places": "bun run src/server/providers/discover-google-places.ts",
    "db:enrich:google-places": "bun run src/server/providers/enrich-google-places.ts",
    "db:prune:google-places": "bun run src/server/jobs/prune-google-places.ts",
    "privacy:closure-worker": "bun run src/server/privacy/run-account-closure-worker.ts",
    "payments:closure-refund-worker": "bun run src/server/trip-pass/run-paid-after-closure-refund-worker.ts",
    "operations:reconcile": "bun run src/server/operations/run-commerce-reconciliation.ts",
    "operations:enqueue": "bun run src/server/operations/run-operational-task-producer.ts",
    "operations:run": "bun run src/server/operations/run-operational-worker.ts --enqueue",
    "operations:worker": "bun run src/server/operations/run-operational-worker.ts",
    "privacy:restore-guard": "bun run src/server/privacy/run-restore-guard.ts",
    "db:ingest:open-meteo": "bun run src/server/providers/ingest-open-meteo.ts",
    "db:ingest:open-meteo-marine": "bun run src/server/providers/ingest-open-meteo-marine.ts",
    "agent-memory:sync": "bun run src/server/chat/sync-agent-memory-vector-store.ts",
    "eval:trip-pass-cost-baseline": "bun run src/server/evaluations/run-trip-pass-cost-baseline.ts",
    "eval:trip-pass-cost-candidate": "bun run src/server/evaluations/run-trip-pass-cost-baseline.ts --candidate",
    "eval:trip-pass-quality-bypass": "bun run src/server/evaluations/run-trip-pass-quality-bypass.ts",
    "eval:reality-check": "bun run src/server/evaluations/run-reality-check-matrix.ts",
    "qa:trip-pass-launch": "bun run src/server/qa/run-trip-pass-launch-proof.ts",
    "qa:provider-rc-evidence": "bun run src/server/qa/run-provider-release-candidate-evidence.ts",
    "qa:provider-rc-preflight": "bun run src/server/qa/run-provider-release-candidate-preflight.ts",
    "db:migrate:test": "bun run src/server/db/migrate-test.ts",
    "db:seed:test": "bun run src/server/db/seed-test.ts",
    "test:integration:postgres": "bun run src/server/integration/postgres-entrypoint.ts",
    "test:integration:redis": "bun run src/server/integration/redis-entrypoint.ts",
    "validate:clerk-deployment": "bun run src/server/auth/validate-clerk-deployment.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "verify": "bun run lint && bun run typecheck --incremental false && bun test",
    "verify:foundation:local": "bun run src/server/qa/run-foundation-local.ts",
    "verify:ci": "bun run verify:foundation:local",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:clerk": "playwright test --config=playwright.clerk.config.ts --grep-invert='final live boundary'",
    "test:e2e:clerk:final-boundary": "playwright test --config=playwright.clerk.config.ts --grep='final live boundary'",
    "test:e2e:clerk:verify-deletion": "bun run src/server/qa/verify-clerk-release-candidate-deletion.ts",
    "test:smoke:trip-pass-stripe": "bun run src/server/qa/run-stripe-release-candidate.ts",
    "test:e2e:stripe:final-boundary": "playwright test --config=playwright.stripe.config.ts --grep='final live boundary'",
    "test:e2e:production-perf": "PLAYWRIGHT_PRODUCTION_PERF=1 playwright test",
    "start": "bun run validate:clerk-deployment && ./node_modules/.bin/next start",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.0",
    "@clerk/ui": "^1.29.0",
    "@electric-sql/pglite": "^0.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "openai": "^7.4.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@clerk/testing": "^2.2.19",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "postcss": "8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.26",
    "uuid": "14.0.1"
  }
}
