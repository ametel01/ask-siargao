# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# Database
DATABASE_URL=postgres://user:password@localhost:5432/siargao_portal

# Stripe
# Prefer a restricted Stripe key (`rk_`) with Checkout Session permissions.
STRIPE_RESTRICTED_KEY=rk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.5
OPENAI_REVIEWER_MODEL=gpt-5.5

# Google Maps Platform
GOOGLE_API_KEY=replace-me

# Background jobs
INNGEST_EVENT_KEY=replace-me
INNGEST_SIGNING_KEY=replace-me
REDIS_URL=redis://localhost:6379

# Rate limiting
# Only enable when the deployment is behind a trusted proxy that owns these headers.
TRUST_PROXY_HEADERS=false

# Admin
ADMIN_ACCESS_TOKEN=replace-me

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
