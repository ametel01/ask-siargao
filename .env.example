# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk
CLERK_AUTH_MODE=disabled
NEXT_PUBLIC_CLERK_AUTH_MODE=disabled
CLERK_DEPLOYMENT_CONTEXT=local
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_PRODUCTION_ORIGIN=https://asksiargao.com
CLERK_PROTECTED_STAGING_ORIGIN=https://staging.asksiargao.com
CLERK_PROTECTED_STAGING_GIT_COMMIT_REF=
CLERK_PROTECTED_STAGING_VERCEL_TARGET_ENV=
CLERK_VERCEL_PROJECT_ID=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
ACCOUNT_CLOSURE_TOMBSTONE_HMAC_KEY=
ACCOUNT_CLOSURE_TOMBSTONE_HMAC_KEY_VERSION=1
ACCOUNT_CLOSURE_TOMBSTONE_HMAC_PREVIOUS_KEYS_JSON=
ACCOUNT_CLOSURE_PROVIDER_SUBJECT_KEY=
ACCOUNT_CLOSURE_PROVIDER_SUBJECT_KEY_VERSION=1
ACCOUNT_CLOSURE_POLICY_VERSION=
ACCOUNT_CLOSURE_RETENTION_DAYS=
ACCOUNT_CLOSURE_ALERT_AFTER_ATTEMPTS=
ACCOUNT_CLOSURE_WORKER_BATCH_SIZE=100
PAID_AFTER_CLOSURE_REFUND_BATCH_SIZE=100
PAID_AFTER_CLOSURE_REFUND_ALERT_AFTER_ATTEMPTS=3
COMMERCE_RETENTION_POLICY_VERSION=
COMMERCE_RETENTION_DAYS=
PAID_ANSWER_DETAIL_RETENTION_DAYS=
PRIVACY_RESTORE_SNAPSHOT_VERSION=
PRIVACY_RESTORE_SOURCE_MAX_CLOSED_AT=
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# Database
DATABASE_URL=postgres://user:password@localhost:5432/siargao_portal
DATABASE_POOL_SIZE=10
DATABASE_CLI_POOL_SIZE=1
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_MAX_LIFETIME_SECONDS=1800
DATABASE_SSL_MODE=disable
DATABASE_STATEMENT_TIMEOUT_MS=0

# Stripe
# Prefer a restricted Stripe key (`rk_`) with Checkout Session permissions.
STRIPE_RESTRICTED_KEY=rk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_TRIP_PASS_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Trip Pass launch flags
TRIP_PASS_CHECKOUT_MODE=off
TRIP_PASS_CHECKOUT_CANARY_ACCOUNT_IDS=
TRIP_PASS_EXTENSION_ENABLED=false
TRIP_PASS_ANON_HMAC_KEY=
TRIP_PASS_ANON_HMAC_KEY_VERSION=1
TRIP_PASS_WAF_MODE=disabled

# DeepSeek primary chat model
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_COST_POLICY_ENABLED=true
DEEPSEEK_DAILY_USD_LIMIT=

# OpenAI fallback and OpenAI-only hosted services
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REVIEWER_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_ENABLED=false
OPENAI_FALLBACK_DAILY_USD_LIMIT=
OPENAI_DAILY_USD_LIMIT=
GLOBAL_MODEL_DAILY_USD_LIMIT=

# Google Maps Platform
GOOGLE_API_KEY=replace-me

# Background jobs
INNGEST_EVENT_KEY=replace-me
INNGEST_SIGNING_KEY=replace-me
REDIS_URL=redis://localhost:6379

# Rate limiting
# Only enable when the deployment is behind a trusted proxy that owns these headers.
TRUST_PROXY_HEADERS=false

# Admin
# Immutable Clerk Account IDs. Production diagnostics and Repair Actions use this allowlist.
OPERATOR_ACCOUNT_IDS=
# Local read-only compatibility only. Never authorizes a production mutation.
ADMIN_ACCESS_TOKEN=replace-me

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
